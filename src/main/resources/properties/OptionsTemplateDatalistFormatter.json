[{
    "title": "@@org.joget.marketplace.OptionsTemplateDatalistFormatter.config@@",
    "properties": [
        {
            "name": "options",
            "label": "@@org.joget.marketplace.OptionsTemplateDatalistFormatter.options@@",
            "type": "grid",
            "columns": [
                {
                    "key": "value",
                    "label": "@@org.joget.marketplace.OptionsTemplateDatalistFormatter.options.value@@"
                },
                {
                    "key": "label",
                    "label": "@@org.joget.marketplace.OptionsTemplateDatalistFormatter.options.label@@"
                }
            ]
        },
        {
            "name": "optionsBinder",
            "label": "@@org.joget.marketplace.OptionsTemplateDatalistFormatter.optionsBinder@@",
            "type": "elementselect",
            "options_ajax": "[CONTEXT_PATH]/web/property/json/getElements?classname=org.joget.apps.form.model.FormLoadOptionsBinder",
            "url": "[CONTEXT_PATH]/web/property/json[APP_PATH]/getPropertyOptions"
        },
        {
            "name": "template",
            "label": "@@org.joget.marketplace.OptionsTemplateDatalistFormatter.template@@",
            "type":"codeeditor",
            "mode":"html",
            "value": "<span class=\"optionsTemplateItem\">\n  <a href=\"view?id={id}\">{label}</a>\n</span>",
            "description": "@@org.joget.marketplace.OptionsTemplateDatalistFormatter.template.desc@@"
        },
        {
            "name": "separator",
            "label": "@@org.joget.marketplace.OptionsTemplateDatalistFormatter.separator@@",
            "type": "textfield",
            "value": "",
            "description": "@@org.joget.marketplace.OptionsTemplateDatalistFormatter.separator.desc@@"
        },
        {
            "name": "customHeader",
            "label": "@@org.joget.marketplace.OptionsTemplateDatalistFormatter.customHeader@@",
            "type": "codeeditor",
            "mode": "html",
            "value": "<style>\n.optionsTemplateItem{\n\tborder-radius: 5px;\n    border: 1px solid grey;\n    padding: 2px 4px;\n    margin: 2px;\n    display: inline-block;\n    background: white;\n  }\n</style>",
            "description": "@@org.joget.marketplace.OptionsTemplateDatalistFormatter.customHeader.desc@@"
        }
    ]
}]
